---
import contact from '../data/contact.json';
const an = new Date().getFullYear();
---

<footer class="bg-stone-800 text-stone-300 mt-20">
  <div class="max-w-5xl mx-auto px-4 py-12 grid gap-8 md:grid-cols-3">

    <div>
      <p class="font-bold text-white text-lg mb-2">Pinro Trepte</p>
      <p class="text-sm leading-relaxed">Producție și montaj trepte din lemn masiv pe suport de beton sau metal.</p>
    </div>

    <div>
      <p class="font-semibold text-white mb-2">Contact</p>
      <ul class="text-sm space-y-1">
        <li><a href={`tel:${contact.telefon.replace(/\s/g,'')}`} class="hover:text-white">{contact.telefon}</a></li>
        <li><a href={`mailto:${contact.email}`} class="hover:text-white">{contact.email}</a></li>
        <li>{contact.adresa}</li>
      </ul>
    </div>

    <div>
      <p class="font-semibold text-white mb-2">Program</p>
      <p class="text-sm whitespace-pre-line leading-relaxed">{contact.program}</p>
    </div>

  </div>
  <div class="border-t border-stone-700 text-center text-xs text-stone-500 py-4">
    © {an} Pinro Trepte. Toate drepturile rezervate.
  </div>
</footer>
