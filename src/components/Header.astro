---
const nav = [
  { href: '/',           label: 'Acasă' },
  { href: '/produse',    label: 'Produse' },
  { href: '/portofoliu', label: 'Portofoliu' },
  { href: '/blog',       label: 'Blog' },
  { href: '/contact',    label: 'Contact' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="bg-white border-b border-stone-100 sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-6 flex items-center justify-between h-18 py-3">

    <a href="/" class="shrink-0">
      <img src="/images/uploads/logo.png" alt="Pinro" class="h-10 w-auto" />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-8 text-sm tracking-wide">
      {nav.map(({ href, label }) => (
        <a
          href={href}
          class={`transition-colors ${
            pathname === href || (href !== '/' && pathname.startsWith(href))
              ? 'text-stone-900 border-b border-stone-900 pb-0.5'
              : 'text-stone-500 hover:text-stone-900'
          }`}
        >
          {label}
        </a>
      ))}
      <a
        href="https://wa.me/40758287719?text=Bun%C4%83%20ziua%2C%20a%C8%99%20dori%20un%20deviz."
        target="_blank"
        rel="noopener"
        class="border border-stone-900 text-stone-900 px-5 py-2 text-sm hover:bg-stone-900 hover:text-white transition-colors"
      >
        Cere ofertă
      </a>
    </nav>

    <!-- Mobile button -->
    <button id="menu-btn" class="md:hidden p-2 text-stone-600" aria-label="Meniu">
      <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="3" y1="6" x2="19" y2="6"/>
        <line x1="3" y1="11" x2="19" y2="11"/>
        <line x1="3" y1="16" x2="19" y2="16"/>
      </svg>
    </button>
  </div>

  <!-- Mobile nav -->
  <nav id="mobile-nav" class="hidden md:hidden bg-white border-t border-stone-100 px-6 py-4 flex flex-col gap-4 text-sm">
    {nav.map(({ href, label }) => (
      <a href={href} class="text-stone-600 hover:text-stone-900 tracking-wide">{label}</a>
    ))}
    <a
      href="https://wa.me/40758287719?text=Bun%C4%83%20ziua%2C%20a%C8%99%20dori%20un%20deviz."
      target="_blank"
      rel="noopener"
      class="border border-stone-900 text-stone-900 px-5 py-2 text-center hover:bg-stone-900 hover:text-white transition-colors"
    >
      Cere ofertă
    </a>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => nav?.classList.toggle('hidden'));
</script>
