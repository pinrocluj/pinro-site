---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  descriere?: string;
}

const { title, descriere = 'Producție și montaj trepte din lemn pe suport de beton sau metal. Calitate, precizie, livrare la timp.' } = Astro.props;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={descriere} />
    <title>{title} | Pinro Trepte</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body class="bg-stone-50 text-stone-900 font-sans antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
