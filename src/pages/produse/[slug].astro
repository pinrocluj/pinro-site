---
import Layout from '../../layouts/Layout.astro';
import { produse } from '../../data/produse';

export function getStaticPaths() {
  return produse.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const produs = produse.find((p) => p.slug === slug);
if (!produs) return Astro.redirect('/produse');
---

<Layout title={produs.titlu} descriere={produs.descriereScurta}>

  <div class="max-w-4xl mx-auto px-4 py-12">

    <a href="/produse" class="text-sm text-lemn-600 hover:underline mb-6 inline-block">← Înapoi la produse</a>

    <h1 class="text-3xl font-bold mb-3">{produs.titlu}</h1>
    <p class="text-stone-500 text-lg mb-8">{produs.descriereScurta}</p>

    <!-- Imagine hero -->
    <img
      src={produs.imagineHero}
      alt={produs.titlu}
      class="w-full rounded-xl shadow-sm mb-6 object-cover max-h-96"
    />

    <!-- Galerie -->
    {produs.galerie.length > 0 && (
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-10">
        {produs.galerie.map((foto) => (
          <img src={foto} alt={produs.titlu} class="rounded-lg w-full object-cover aspect-video" />
        ))}
      </div>
    )}

    <div class="grid md:grid-cols-3 gap-8">

      <!-- Descriere -->
      <div class="md:col-span-2">
        <h2 class="text-xl font-bold mb-4">Despre produs</h2>
        <div class="prose prose-stone max-w-none text-stone-700 leading-relaxed">
          {produs.descriere.split('\n\n').map((para) => (
            <p class="mb-4" set:html={para.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')} />
          ))}
        </div>
      </div>

      <!-- Specificații + CTA -->
      <div>
        <div class="bg-stone-50 rounded-xl p-5 mb-6">
          <h2 class="font-bold text-lg mb-4">Specificații</h2>
          <dl class="space-y-2">
            {produs.specificatii.map((spec) => (
              <div class="flex flex-col">
                <dt class="text-xs text-stone-400 uppercase tracking-wide">{spec.label}</dt>
                <dd class="text-stone-800 font-medium text-sm">{spec.valoare}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="bg-lemn-600 text-white rounded-xl p-5 text-center">
          <p class="font-semibold mb-1">Vrei un deviz?</p>
          <p class="text-lemn-100 text-sm mb-4">Răspundem în aceeași zi lucrătoare.</p>
          <a
            href={`https://wa.me/40758287719?text=Bun%C4%83%20ziua%2C%20a%C8%99%20dori%20un%20deviz%20pentru%20${encodeURIComponent(produs.titlu)}.`}
            target="_blank"
            rel="noopener"
            class="block bg-white text-lemn-700 font-semibold py-2 rounded hover:bg-lemn-50 transition-colors text-sm"
          >
            Cere ofertă pe WhatsApp
          </a>
          <a
            href="tel:0758287719"
            class="block mt-2 text-lemn-100 hover:text-white text-sm transition-colors"
          >
            📞 0758 287 719
          </a>
        </div>
      </div>

    </div>
  </div>

</Layout>
