---
import Layout from '../../layouts/Layout.astro';
import { produse } from '../../data/produse';

export function getStaticPaths() {
  return produse.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const produs = produse.find((p) => p.slug === slug);
if (!produs) return Astro.redirect('/produse');
---

<Layout title={produs.titlu} descriere={produs.descriereScurta}>
  <div class="max-w-6xl mx-auto px-6 py-16">

    <a href="/produse" class="text-xs text-stone-400 tracking-wide hover:text-stone-900 transition-colors mb-10 inline-block">← Înapoi la produse</a>

    <!-- Hero imagine -->
    <div class="aspect-video md:aspect-[16/7] overflow-hidden bg-stone-100 mb-12">
      <img src={produs.imagineHero} alt={produs.titlu} class="w-full h-full object-cover" />
    </div>

    <div class="grid md:grid-cols-3 gap-16">

      <!-- Stânga: descriere -->
      <div class="md:col-span-2">
        <p class="text-xs font-semibold tracking-widest text-stone-400 uppercase mb-3">Produs</p>
        <h1 class="font-heading text-4xl text-stone-900 mb-6">{produs.titlu}</h1>

        <div class="text-stone-600 text-base leading-relaxed space-y-4">
          {produs.descriere.split('\n\n').map((para) => (
            <p set:html={para.replace(/\*\*(.*?)\*\*/g, '<strong class="text-stone-900">$1</strong>')} />
          ))}
        </div>

        <!-- Galerie -->
        {produs.galerie.length > 0 && (
          <div class="grid grid-cols-2 gap-3 mt-10">
            {produs.galerie.map((foto) => (
              <div class="overflow-hidden aspect-video bg-stone-100">
                <img src={foto} alt={produs.titlu} class="w-full h-full object-cover" />
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Dreapta: specificații + CTA -->
      <div>
        <div class="border-t border-stone-200 pt-8 mb-10">
          <p class="text-xs font-semibold tracking-widest text-stone-400 uppercase mb-6">Specificații</p>
          <dl class="space-y-4">
            {produs.specificatii.map((spec) => (
              <div>
                <dt class="text-xs text-stone-400 uppercase tracking-wide">{spec.label}</dt>
                <dd class="text-stone-800 mt-0.5">{spec.valoare}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="border-t border-stone-200 pt-8">
          <p class="text-xs font-semibold tracking-widest text-stone-400 uppercase mb-4">Deviz gratuit</p>
          <p class="text-stone-500 text-sm mb-6 leading-relaxed">Răspundem în aceeași zi lucrătoare cu un deviz personalizat.</p>
          <a
            href={`https://wa.me/40758287719?text=Bun%C4%83%20ziua%2C%20a%C8%99%20dori%20un%20deviz%20pentru%20${encodeURIComponent(produs.titlu)}.`}
            target="_blank"
            rel="noopener"
            class="block border border-stone-900 text-stone-900 text-sm text-center py-3 px-6 hover:bg-stone-900 hover:text-white transition-colors mb-3"
          >
            Cere ofertă pe WhatsApp
          </a>
          <a
            href="tel:0758287719"
            class="block text-center text-sm text-stone-500 hover:text-stone-900 transition-colors"
          >
            0758 287 719
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>
