---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const lucrari = await getCollection('portofoliu');
---

<Layout title="Portofoliu" descriere="Galerie cu lucrări de trepte din lemn masiv pe suport de beton și metal.">

  <div class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-2">Portofoliu</h1>
    <p class="text-stone-500 mb-10">Lucrări realizate de echipa Pinro Trepte.</p>

    {lucrari.length === 0 ? (
      <p class="text-stone-400 text-center py-20">Lucrările vor apărea aici după ce sunt adăugate din panoul de administrare.</p>
    ) : (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {lucrari.map((l) => (
          <a href={`/portofoliu/${l.slug}`} class="bg-white rounded-lg overflow-hidden shadow-sm border border-stone-100 hover:shadow-md transition-shadow group">
            <div class="aspect-video bg-stone-100 overflow-hidden">
              {l.data.imagine_principala && (
                <img
                  src={l.data.imagine_principala}
                  alt={l.data.titlu}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              )}
            </div>
            <div class="p-4">
              <h2 class="font-semibold text-stone-800 leading-snug">{l.data.titlu}</h2>
              <div class="flex items-center gap-3 mt-2">
                <span class="text-xs bg-lemn-100 text-lemn-700 px-2 py-0.5 rounded capitalize">{l.data.suport}</span>
                {l.data.an && <span class="text-xs text-stone-400">{l.data.an}</span>}
              </div>
              {l.data.descriere && <p class="text-sm text-stone-500 mt-2 line-clamp-2">{l.data.descriere}</p>}
            </div>
          </a>
        ))}
      </div>
    )}
  </div>

</Layout>
