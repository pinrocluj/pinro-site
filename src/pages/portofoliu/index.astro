---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const lucrari = await getCollection('portofoliu');
---

<Layout title="Portofoliu" descriere="Galerie lucrări Pinro — trepte din lemn masiv pe beton și metal.">
  <div class="max-w-6xl mx-auto px-6 py-20">

    <p class="text-xs font-semibold tracking-widest text-stone-400 uppercase mb-3">Portofoliu</p>
    <h1 class="font-heading text-4xl text-stone-900 mb-4">Lucrările noastre</h1>
    <p class="text-stone-500 text-lg mb-16 max-w-xl">Fiecare proiect realizat, în detaliu.</p>

    {lucrari.length === 0 ? (
      <p class="text-stone-400 text-center py-32">Lucrările vor apărea aici după ce sunt adăugate din panoul de administrare.</p>
    ) : (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {lucrari.map((l) => (
          <a href={`/portofoliu/${l.slug}`} class="group block">
            <div class="overflow-hidden aspect-video bg-stone-100 mb-4">
              <img src={l.data.imagine_principala} alt={l.data.titlu} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="flex items-start justify-between">
              <div>
                <h2 class="font-heading text-lg text-stone-900 leading-snug">{l.data.titlu}</h2>
                <p class="text-xs text-stone-400 mt-1 capitalize">{l.data.suport}{l.data.an ? ` · ${l.data.an}` : ''}</p>
              </div>
              <span class="text-stone-400 group-hover:text-stone-900 transition-colors mt-1 shrink-0 ml-4">→</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>
