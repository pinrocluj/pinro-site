---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import contact from '../data/contact.json';

const lucrari = (await getCollection('portofoliu')).slice(0, 4);
const articole = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const categorii = [
  { titlu: 'Scări drepte\npe beton',  href: '/produse/scari-drepte-beton', imagine: '/images/uploads/cat-scari-drepte-beton-(1).JPEG' },
  { titlu: 'Scări drepte\npe metal',  href: '/produse/scari-drepte-metal',  imagine: '/images/uploads/cat-scari-drepte-metal-(4).JPEG' },
  { titlu: 'Scări în unghi\npe beton',href: '/produse/scari-unghi-beton',   imagine: '/images/uploads/cat-scari-unghi-beton-(8).JPEG' },
  { titlu: 'Scări în unghi\npe metal', href: '/produse/scari-unghi-metal', imagine: '/images/uploads/cat-scari-unghi-metal-(5).JPEG' },
];
---

<Layout title="Acasă" descriere="SC Pinro SRL — Producție și montaj trepte din lemn masiv pe suport de beton sau metal. Baciu, Cluj. Tel: 0758 287 719.">

  <!-- Hero full-bleed -->
  <section class="relative h-[90vh] min-h-[560px] flex items-end overflow-hidden">
    <img
      src="/images/uploads/scari-unghi-beton-(4).JPEG"
      alt="Trepte din lemn masiv Pinro"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 pb-16 md:pb-24 w-full">
      <p class="text-lemn-300 text-sm tracking-widest uppercase mb-4">SC Pinro SRL · Baciu, Cluj</p>
      <h1 class="font-heading text-5xl md:text-7xl text-white leading-tight mb-6 max-w-2xl">
        Trepte din<br/>lemn masiv
      </h1>
      <p class="text-stone-300 text-lg mb-8 max-w-lg">
        Produse la comandă, montate pe orice tip de structură — beton sau metal.
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          href="https://wa.me/40758287719?text=Bun%C4%83%20ziua%2C%20a%C8%99%20dori%20un%20deviz."
          target="_blank" rel="noopener"
          class="bg-white text-stone-900 px-8 py-3 text-sm tracking-wide hover:bg-stone-100 transition-colors"
        >
          Cere ofertă gratuită
        </a>
        <a
          href="/portofoliu"
          class="border border-white text-white px-8 py-3 text-sm tracking-wide hover:bg-white/10 transition-colors"
        >
          Vezi portofoliu
        </a>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="max-w-3xl mx-auto px-6 py-24 text-center">
    <h2 class="font-heading text-4xl text-stone-900 mb-6">Meșteșug și precizie,<br/>în fiecare treaptă</h2>
    <p class="text-stone-500 text-lg leading-relaxed">
      La Pinro producem și montăm trepte din stejar masiv în atelierul nostru din Baciu, Cluj.
      Fiecare piesă este croită după măsurătorile tale exacte — nu vindem din stoc, producem pentru tine.
    </p>
  </section>

  <!-- Produse grid -->
  <section class="max-w-6xl mx-auto px-6 pb-24">
    <p class="text-xs font-semibold tracking-widest text-stone-400 uppercase mb-8">Produsele noastre</p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      {categorii.map((cat) => (
        <a href={cat.href} class="relative overflow-hidden group block aspect-[3/4]">
          <img
            src={cat.imagine}
            alt={cat.titlu}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
          <div class="absolute inset-0 bg-black/30 group-hover:bg-black/40 transition-colors"></div>
          <div class="absolute bottom-0 left-0 right-0 p-4">
            <p class="text-white text-sm font-medium leading-snug whitespace-pre-line">{cat.titlu}</p>
          </div>
        </a>
      ))}
    </div>
    <div class="mt-6 text-right">
      <a href="/produse" class="text-sm text-stone-500 hover:text-stone-900 tracking-wide transition-colors">Toate produsele →</a>
    </div>
  </section>

  <!-- De ce Pinro -->
  <section class="border-t border-stone-100 bg-stone-50">
    <div class="max-w-6xl mx-auto px-6 py-24 grid md:grid-cols-3 gap-12">
      <div>
        <p class="text-xs font-semibold tracking-widest text-stone-400 uppercase mb-4">01</p>
        <h3 class="font-heading text-xl text-stone-900 mb-3">Stejar masiv certificat</h3>
        <p class="text-stone-500 text-sm leading-relaxed">Lucrăm exclusiv cu lemn masiv de stejar din surse sustenabile. Grosimi de la 40mm la 80mm, adaptate tipului de structură.</p>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-widest text-stone-400 uppercase mb-4">02</p>
        <h3 class="font-heading text-xl text-stone-900 mb-3">Producție la comandă</h3>
        <p class="text-stone-500 text-sm leading-relaxed">Fiecare piesă este croită după măsurătorile tale exacte. Vizită gratuită la fața locului, deviz în aceeași zi.</p>
      </div>
      <div>
        <p class="text-xs font-semibold tracking-widest text-stone-400 uppercase mb-4">03</p>
        <h3 class="font-heading text-xl text-stone-900 mb-3">Cluj și împrejurimi</h3>
        <p class="text-stone-500 text-sm leading-relaxed">Atelier în Baciu, jud. Cluj. Livrăm și montăm în Cluj-Napoca și județul Cluj.</p>
      </div>
    </div>
  </section>

  <!-- Portofoliu -->
  {lucrari.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 py-24">
      <p class="text-xs font-semibold tracking-widest text-stone-400 uppercase mb-8">Lucrări recente</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
        {lucrari.map((l) => (
          <a href={`/portofoliu/${l.slug}`} class="group block overflow-hidden">
            <div class="aspect-square overflow-hidden bg-stone-100">
              <img
                src={l.data.imagine_principala}
                alt={l.data.titlu}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="pt-3">
              <p class="text-sm text-stone-800 font-medium leading-snug">{l.data.titlu}</p>
              <p class="text-xs text-stone-400 mt-1 capitalize">{l.data.suport}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-8 text-right">
        <a href="/portofoliu" class="text-sm text-stone-500 hover:text-stone-900 tracking-wide transition-colors">Toate lucrările →</a>
      </div>
    </section>
  )}

  <!-- Blog -->
  {articole.length > 0 && (
    <section class="border-t border-stone-100 bg-stone-50">
      <div class="max-w-6xl mx-auto px-6 py-24">
        <p class="text-xs font-semibold tracking-widest text-stone-400 uppercase mb-8">Din blog</p>
        <div class="grid md:grid-cols-3 gap-8">
          {articole.map((a) => (
            <a href={`/blog/${a.slug}`} class="group block">
              {a.data.imagine && (
                <div class="aspect-video overflow-hidden bg-stone-100 mb-4">
                  <img src={a.data.imagine} alt={a.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                </div>
              )}
              <p class="text-xs text-stone-400 mb-2">{a.data.date.toLocaleDateString('ro-RO')}</p>
              <h3 class="font-heading text-stone-900 leading-snug group-hover:text-lemn-700 transition-colors">{a.data.title}</h3>
            </a>
          ))}
        </div>
        <div class="mt-8 text-right">
          <a href="/blog" class="text-sm text-stone-500 hover:text-stone-900 tracking-wide transition-colors">Toate articolele →</a>
        </div>
      </div>
    </section>
  )}

  <!-- CTA final -->
  <section class="max-w-6xl mx-auto px-6 py-24 text-center">
    <h2 class="font-heading text-4xl text-stone-900 mb-4">Ai un proiect?</h2>
    <p class="text-stone-500 mb-2">Sună-ne sau scrie-ne pe WhatsApp.</p>
    <p class="font-heading text-3xl text-stone-900 mb-8">
      <a href={`tel:${contact.telefon.replace(/\s/g,'')}`} class="hover:text-lemn-700 transition-colors">{contact.telefon}</a>
    </p>
    <a
      href="https://wa.me/40758287719?text=Bun%C4%83%20ziua%2C%20a%C8%99%20dori%20un%20deviz."
      target="_blank" rel="noopener"
      class="inline-block border border-stone-900 text-stone-900 px-10 py-3 text-sm tracking-wide hover:bg-stone-900 hover:text-white transition-colors"
    >
      Scrie pe WhatsApp
    </a>
  </section>

</Layout>
